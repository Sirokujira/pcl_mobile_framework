version: 1.0.{build}

image: Visual Studio 2015

cache:
- cachebuild

# Android NDK Toolchains
# https://developer.android.com/ndk/guides/standalone_toolchain.html?hl=ja
# Compiling PCL for android(windows)
# mingw + windows
# https://hcteq.wordpress.com/2014/07/14/compiling-pcl-for-android-in-windows-cmake-gui/
# Build environment
# https://www.appveyor.com/docs/build-environment/
# -DCMAKE_C_COMPILER="C:/projects/android-ndk-r16b/toolchains/arm-linux-androideabi-4.9/prebuilt/windows-x86_64/bin/arm-linux-androideabi-gcc.exe"
# -DCMAKE_CXX_COMPILER="C:/projects/android-ndk-r16b/toolchains/arm-linux-androideabi-4.9/prebuilt/windows-x86_64/bin/arm-linux-androideabi-g++.exe"
# Toolchain
# https://developer.android.com/ndk/guides/standalone_toolchain.html
environment:
    matrix:
    # clang
    # armeabi
    - MinGW_ROOT: "C:\\MinGW"
      MinGW: "C:\\MinGW\\bin"
      MSYS_ROOT: "C:\\MinGW\\msys\\1.0"
      ANDROID_NDK: "C:/projects/android-ndk-r16b"
      CMAKE_COMMAND: "C:\\Program Files (x86)\\cmake\\bin"
      ANDROID_ABIs: "armeabi"
      ANDROID_TARGET_API: "26"
      TOOLCHAIN_NAME: "arm-linux-android-clang3.6"
      TARGET_COMPILER: "clang"

    # armeabi-v7a
    - MinGW_ROOT: "C:\\MinGW"
      MinGW: "C:\\MinGW\\bin"
      MSYS_ROOT: "C:\\MinGW\\msys\\1.0"
      ANDROID_NDK: "C:/projects/android-ndk-r16b"
      CMAKE_COMMAND: "C:\\Program Files (x86)\\cmake\\bin"
      ANDROID_ABIs: "armeabi-v7a"
      ANDROID_TARGET_API: "26"
      TOOLCHAIN_NAME: "arm-linux-android-clang3.6"
      TARGET_COMPILER: "clang"

    # "arm64-v8a"
    # - MinGW_ROOT: "C:\\mingw-w64\\x86_64-6.3.0-posix-seh-rt_v5-rev1"
    - MinGW_ROOT: "C:\\MinGW"
      MinGW: "C:\\MinGW\\bin"
      MSYS_ROOT: "C:\\MinGW\\msys\\1.0"
      ANDROID_NDK: "C:/projects/android-ndk-r16b"
      CMAKE_COMMAND: "C:\\Program Files (x86)\\cmake\\bin"
      ANDROID_ABIs: "arm64-v8a"
      ANDROID_TARGET_API: "26"
      TOOLCHAIN_NAME: "aarch64-linux-android-clang3.6"
      TARGET_COMPILER: "clang"

    # (mips64)(simulation?)
    # - MinGW_ROOT: "C:\\MinGW"
    # - MinGW_ROOT: "C:\\mingw-w64\\x86_64-6.3.0-posix-seh-rt_v5-rev1"
    #   MinGW: "C:\\MinGW\\bin"
    #   MSYS_ROOT: "C:\\MinGW\\msys\\1.0"
    #   ANDROID_NDK: "C:\\projects\\android-ndk-r16b"
    #   CMAKE_COMMAND: "C:\\Program Files (x86)\\cmake\\bin"
    #   ANDROID_ABIs: "mips64"
    #   ANDROID_TARGET_API: "26"
    #   TOOLCHAIN_NAME: "mips64el-linux-android-clang3.6"
    #   TARGET_COMPILER: "clang"

    # (x86_64)(simulation?)
    # - MinGW_ROOT: "C:\\mingw-w64\\x86_64-6.3.0-posix-seh-rt_v5-rev1"
    - MinGW_ROOT: "C:\\MinGW"
      MinGW: "C:\\MinGW\\bin"
      MSYS_ROOT: "C:\\MinGW\\msys\\1.0"
      ANDROID_NDK: "C:\\projects\\android-ndk-r16b"
      CMAKE_COMMAND: "C:\\Program Files (x86)\\cmake\\bin"
      ANDROID_ABIs: "x86_64"
      ANDROID_TARGET_API: "26"
      TOOLCHAIN_NAME: "x86_64-linux-android-clang3.6"
      TARGET_COMPILER: "clang"

    # (x86)(simulation?)
    - MinGW_ROOT: "C:\\MinGW"
      MinGW: "C:\\MinGW\\bin"
      MSYS_ROOT: "C:\\MinGW\\msys\\1.0"
      ANDROID_NDK: "C:\\projects\\android-ndk-r16b"
      CMAKE_COMMAND: "C:\\Program Files (x86)\\cmake\\bin"
      ANDROID_ABIs: "x86"
      ANDROID_TARGET_API: "26"
      TOOLCHAIN_NAME: "x86-linux-android-clang3.6"
      TARGET_COMPILER: "clang"

    # 64 bit?
    # - MinGW_ROOT: "C:\\mingw-w64\\x86_64-6.3.0-posix-seh-rt_v5-rev1"
    #   MinGW: "C:\\mingw-w64\\x86_64-6.3.0-posix-seh-rt_v5-rev1\\bin"
    #   MSYS_ROOT: "C:\\msys64"
    #   ANDROID_NDK: "C:\\projects\\android-ndk-r16b"
    #   CMAKE_COMMAND: "C:\\Program Files (x86)\\cmake\\bin"


# https://github.com/boostorg/hana/blob/master/.appveyor.yml
# - ps: Import-Module ".\appveyor\PS-Zip\PS-Zip.psm1" -Force
# - ps: .\appveyor\install.ps1
# ############################################################################
# # All external dependencies are installed in C:\projects\deps
# ############################################################################
# - mkdir C:\projects\deps
#
# ############################################################################ 
# # Install a recent CMake 
# ############################################################################ 
# - set CMAKE_URL="https://cmake.org/files/v3.10/cmake-3.10.0-win64-x64.zip" 
# - appveyor DownloadFile %CMAKE_URL% -FileName cmake.zip 
# - 7z x cmake.zip -oC:\projects\deps > nul 
# - move C:\projects\deps\cmake-* C:\projects\deps\cmake # Move to a version-agnostic directory 
# - set PATH=C:\projects\deps\cmake\bin;%PATH% 
# - cmake --version 

# ############################################################################
# # Install Ninja
# ############################################################################
# - set NINJA_URL="https://github.com/ninja-build/ninja/releases/download/v1.8.2/ninja-win.zip"
# - appveyor DownloadFile %NINJA_URL% -FileName ninja.zip
# - 7z x ninja.zip -oC:\projects\deps\ninja > nul
# - set PATH=C:\projects\deps\ninja;%PATH%
# - ninja --version
install:
    - mkdir C:\projects\deps
    - set CMAKE_URL="https://cmake.org/files/v3.10/cmake-3.10.1-win64-x64.zip"
    - appveyor DownloadFile %CMAKE_URL% -FileName cmake.zip
    - 7z x cmake.zip -oC:\projects\deps > nul 
    - move C:\projects\deps\cmake-* C:\projects\deps\cmake # Move to a version-agnostic directory 
    - set PATH=C:\projects\deps\cmake\bin;%PATH% 
    - cmake --version
    - set NINJA_URL="https://github.com/ninja-build/ninja/releases/download/v1.8.2/ninja-win.zip"
    - appveyor DownloadFile %NINJA_URL% -FileName ninja.zip
    - 7z x ninja.zip -oC:\projects\deps\ninja > nul
    - set PATH=C:\projects\deps\ninja;%PATH%
    - ninja --version


# CMake building for MinGW issue with Git sh.exe 
# http://help.appveyor.com/discussions/problems/3193-cmake-building-for-mingw-issue-with-git-shexe
# https://github.com/jibsen/brieflz/blob/0c6fb73984f11e697dfaade5cdc5e291c1655c67/appveyor.yml
# 32bit?
# set PATH=%PATH:C:\Program Files (x86)\Git\bin;=%
# long path(boost)
# https://stackoverflow.com/questions/22575662/filename-too-long-in-git-for-windows
# git config --system core.longpaths true
# MinGW
# - set PATH=%MinGW%;%PATH%
# - copy "C:\MinGW\bin\mingw32-make.exe" "C:\MinGW\bin\make.exe"
# use Android_NDK make.exe
# -DCMAKE_C_COMPILER="C:/projects/android-ndk-r16b/toolchains/arm-linux-androideabi-4.9/prebuilt/windows-x86_64/bin/arm-linux-androideabi-gcc-4.9.exe"
# -DCMAKE_CXX_COMPILER="C:/projects/android-ndk-r16b/toolchains/arm-linux-androideabi-4.9/prebuilt/windows-x86_64/bin/arm-linux-androideabi-g++.exe"
# - CC="arm-linux-androideabi-gcc" CXX="arm-linux-androideabi-g++.exe" cmake -G "MinGW Makefiles" -DCMAKE_TOOLCHAIN_FILE="%ANDROID_NDK%/build/cmake/android.toolchain.cmake" -DCMAKE_MAKE_PROGRAM="%ANDROID_NDK%/prebuilt/windows-x86_64/bin/make.exe" -DANDROID_ABI="%ANDROID_ABIs%" -DCMAKE_C_COMPILER="arm-linux-androideabi-gcc-4.9.exe" -DCMAKE_CXX_COMPILER="arm-linux-androideabi-g++.exe" -DBUILD_ANDROID:BOOL="ON" -DBUILD_IOS_DEVICE:BOOL="OFF" -DBUILD_IOS_SIMULATOR:BOOL="OFF" ../
# - set PATH=%PATH:C:\Program Files (x86)\cmake\bin;=%
# https://cmake.org/cmake/help/v3.10/manual/cmake-toolchains.7.html#cross-compiling-for-android
# 
# pcl build error(cc1plus.exe: out of memory allocating 1507008 bytes)
# https://stackoverflow.com/questions/29194247/how-to-diagnose-g-error-cc1plus-exe-out-of-memory-allocating-838860800-bytes
# - wmic pagefileset where NAME="C:\\pagefile.sys" set INITIALSIZE=2048, MAXIMUMSIZE=8192
# g++ error
# https://sourceforge.net/p/mingw-w64/mailman/message/33182613/
# -ftrack-macro-expansion=0
before_build:
    - chcp 65001
    - git config --system core.longpaths true
    - set PATH=%PATH:C:\Program Files\Git\usr\bin;=%
    - set PATH=%MINGW%;%PATH%
    - set PATH=%ANDROID_NDK%/toolchains/%TOOLCHAIN_NAME%/prebuilt/windows-x86_64/bin;%PATH%
    - copy "C:\MinGW\bin\mingw32-make.exe" "C:\MinGW\bin\make.exe"
    - wmic pagefileset where NAME="C:\\pagefile.sys" set INITIALSIZE=4096, MAXIMUMSIZE=8192
    - mkdir -p cachebuild
    - cd cachebuild
    - cmake -G "Ninja" -DCMAKE_TOOLCHAIN_FILE:FILEPATH=%ANDROID_NDK%/build/cmake/android.toolchain.cmake -DANDROID_TOOLCHAIN_NAME=%TOOLCHAIN_NAME% -DANDROID_NATIVE_API_LEVEL=%ANDROID_TARGET_API% -DANDROID_ABI=%ANDROID_ABIs% -DANDROID_TOOLCHAIN=%TARGET_COMPILER% -DBUILD_ANDROID:BOOL="ON" -DBUILD_IOS_DEVICE:BOOL="OFF" -DBUILD_IOS_SIMULATOR:BOOL="OFF" ../
    # - cmake -G "MinGW Makefiles" -DCMAKE_TOOLCHAIN_FILE:FILEPATH=%ANDROID_NDK%/build/cmake/android.toolchain.cmake -DANDROID_TOOLCHAIN_NAME=%TOOLCHAIN_NAME% -DANDROID_NATIVE_API_LEVEL=%ANDROID_TARGET_API% -DANDROID_ABI=%ANDROID_ABIs% -DANDROID_TOOLCHAIN=%TARGET_COMPILER% -DBUILD_ANDROID:BOOL="ON" -DBUILD_IOS_DEVICE:BOOL="OFF" -DBUILD_IOS_SIMULATOR:BOOL="OFF" ../

# NG
# Eigen files no ext
# 7z a pcl_mobile_framework_%ANDROID_ABIs%.zip -r ./CMakeExternals/Install/*.*
build_script:
- cmd: >-
    cmake.exe --build . --config Release

    cd ..

    7z a ./pcl_mobile_framework_%ANDROID_ABIs%.zip -r ./cachebuild/CMakeExternals/Install/boost-android

    7z a ./pcl_mobile_framework_%ANDROID_ABIs%.zip -r ./cachebuild/CMakeExternals/Install/flann-android

    7z a ./pcl_mobile_framework_%ANDROID_ABIs%.zip -r ./cachebuild/CMakeExternals/Install/eigen

    7z a ./pcl_mobile_framework_%ANDROID_ABIs%.zip -r ./cachebuild/CMakeExternals/Install/qhull-android

    7z a ./pcl_mobile_framework_%ANDROID_ABIs%.zip -r ./cachebuild/CMakeExternals/Install/pcl-android

# on successful build
# on_success:
#  - 7z a pcl_mobile_framework_%ANDROID_ABIs%.zip -r ./CMakeExternals/Install/*

# on build failure
# on_failure:
#   - 7z a pcl_mobile_framework_%ANDROID_ABIs%.zip -r ./CMakeExternals/Install/*

# - path: cachebuild\pcl_mobile_framework_%ANDROID_ABIs%.zip
artifacts:
- path: pcl_mobile_framework_%ANDROID_ABIs%.zip
  name: Release

