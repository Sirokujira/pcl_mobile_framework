# =============================================================================
# .gitignore — pcl_mobile_framework
# Covers: macOS · iOS/Xcode · Android/Gradle · Flutter/Dart · CMake/PCL build
# =============================================================================

# ─── OS noise ─────────────────────────────────────────────────────────────────
**/.DS_Store
**/.AppleDouble
**/.LSOverride
**/._*
**/Thumbs.db
**/ehthumbs.db
**/desktop.ini
**/$RECYCLE.BIN/
**/Icon?

# ─── Editors ──────────────────────────────────────────────────────────────────
# VS Code (keep project-shared settings)
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json

# Claude Code per-project state (settings.local.json, hooks, etc.)
**/.claude/

# JetBrains / Android Studio
# NOTE: AndroidWrapper/aar/.idea/ is intentionally tracked; new .idea dirs
#       in other locations are ignored by the patterns below.
**/.idea/workspace.xml
**/.idea/tasks.xml
**/.idea/usage.statistics.xml
**/.idea/dictionaries
**/.idea/shelf
**/.idea/caches
**/.idea/navEditor.xml
**/.idea/assetWizardSettings.xml

# Vim / Emacs
**/*.swp
**/*.swo
**/*~
**/#*#

# ─── iOS / Xcode ──────────────────────────────────────────────────────────────
# Xcode user data
**/xcuserdata/
**/*.xcscmblueprint
**/*.xccheckout
**/*.moved-aside
**/*.pbxuser
!**/default.pbxuser
**/*.mode1v3
!**/default.mode1v3
**/*.mode2v3
!**/default.mode2v3
**/*.perspectivev3
!**/default.perspectivev3

# Build artifacts
**/DerivedData/
**/*.ipa
**/*.dSYM.zip
**/*.dSYM

# CocoaPods (consumers; the wrapper podspec itself is tracked)
/Pods/
**/*.xcworkspace
!**/default.xcworkspace
**/Podfile.lock

# Swift Package Manager
**/.build/
**/Package.resolved

# xcodegen-generated .xcodeproj (project.yml is source of truth)
ios/SampleApp/**/*.xcodeproj/
ios/SampleApp/**/*.xcodeproj

# ─── Android / Gradle ─────────────────────────────────────────────────────────
# Gradle caches (keep gradle-wrapper.jar / gradle-wrapper.properties)
**/.gradle/
!**/gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.properties

# Build outputs
**/build/
**/gen/
**/out/
**/bin/
**/obj/
**/captures/
**/.navigation/
**/.externalNativeBuild/
**/.cxx/

# Local SDK pointer — machine-specific
**/local.properties

# APK / AAB / DEX / class files
**/*.apk
**/*.ap_
**/*.aab
**/*.dex
**/*.class

# Android signing keystores
**/*.jks
**/*.keystore

# Log files
**/*.log

# Google Services — do not commit API keys
**/google-services.json
**/GoogleService-Info.plist

# Fastlane CI output
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots/
**/fastlane/test_output/

# ─── Flutter / Dart ───────────────────────────────────────────────────────────
# Dart / Flutter tool cache
**/.dart_tool/
**/.packages
**/.pub-cache/
**/.pub/

# Flutter plugin resolution files
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Flutter web / desktop generated
**/flutter_*.js
**/flutter_*.js.map
**/flutter_export_environment.sh
**/ServiceWorker.js

# Generated Dart code (build_runner, freezed, json_serializable, mockito…)
**/*.g.dart
**/*.freezed.dart
**/*.gr.dart
**/*.mocks.dart

# Flutter Version Manager
**/.fvm/
**/fvm_config.json

# Dart-generated docs
**/doc/api/

# Test coverage
**/coverage/

# pubspec.lock: committed for apps, ignored for plugin packages.
# FlutterWrapper is a plugin package → ignore its lock file.
FlutterWrapper/**/pubspec.lock

# ─── CMake / PCL superbuild ───────────────────────────────────────────────────
# Top-level build directory (PCL libraries, xcframeworks, AARs)
/build/

# Per-slice iOS framework build dirs produced by cmake -G Xcode
/iOSWrapper/build*/
/iOSWrapper/*.xcframework/
/iOSWrapper/PCLMobile.xcframework.zip

# Android native libs — regenerated by scripts/build_android.sh
/AndroidWrapper/aar/pclmobile/libs/
/AndroidWrapper/aar/app/libs/
